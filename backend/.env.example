# Database
DATABASE_URL=sqlite+aiosqlite:///./mazdoormitra.db
# Or Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret (generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Gnani speech APIs (https://app.gnani.ai)
# Prisma and Timbre keys need their corresponding service scopes.
GNANI_PRISMA_API_KEY=
GNANI_PRISMA_API_URL=https://api.vachana.ai/stt/v3

GNANI_TIMBRE_API_KEY=
GNANI_TIMBRE_API_URL=https://api.vachana.ai/api/v1/tts/inference

# Evon API integration. A provider 403 remains a hard failure; no mock fallback is used.
GNANI_EVON_API_KEY=
GNANI_EVON_API_URL=https://api.vachana.ai/v1/chat/completions
GNANI_EVON_BACKEND=api
GNANI_EVON_MODEL_ID=gnani/gnani-evon-v3.3-30B-A3B

# Optional local Evon v3.3 Transformers backend. Install requirements-evon-local.txt
# only on Linux with a supported CUDA host and about 70 GB combined GPU memory.
# Keep api as default on development laptops and route local mode only to a provisioned host.

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
